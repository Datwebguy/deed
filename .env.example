# SERV Reasoning (console.openserv.ai) — turn on data collection in Organization settings
SERV_API_KEY=
# Optional overrides
# SERV_DECIDE_MODEL=gpt-5.4-mini-serv-kronos-multipath
# SERV_CHECK_MODEL=gpt-5.4-mini-serv-kronos

# Coinbase Developer Platform (portal.cdp.coinbase.com) — used by AgentKit for the trust wallets
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# base-sepolia (default) or base
TRUST_NETWORK=base-sepolia
# A dedicated Base RPC is recommended (the public one is rate limited)
# BASE_RPC_URL=
# LOGS_WINDOW=9000

# Set on Vercel to store trusts in Vercel Blob instead of local files
# BLOB_READ_WRITE_TOKEN=
